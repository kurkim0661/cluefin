# 저장소 루트 .env 견본. `cp .env.sample .env` 후 필요한 값만 채우세요.
# cluefin-store / cluefin-agent / cluefin-web 진입점이 실행 시 이 파일을 읽습니다.
# 실제 환경변수(export)가 항상 이 파일보다 우선합니다. 다른 경로를 쓰려면 CLUEFIN_ENV_FILE을 지정하세요.

# --- LLM 게이트웨이 (일일 리포트 에이전트, SQL 워크벤치의 자연어 → SQL) ---
# 이미 export된 키가 있으면 값을 복사하지 말고 ${VAR}로 가리키세요.
#   CLUEFIN_LLM_PAT=${MY_GATEWAY_TOKEN}
# CLUEFIN_LLM_* 가 비어 있으면 LLM_API_KEY / OPENAI_API_KEY, LLM_BASE_URL / OPENAI_BASE_URL,
# LLM_MODEL / OPENAI_MODEL 순으로 자동 인식합니다.
CLUEFIN_LLM_PAT=
CLUEFIN_LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
CLUEFIN_LLM_MODEL=your-model-name

# --- 계약 시장지표 피드 (선택) ---
CLUEFIN_VENDOR_METRICS_URL=
CLUEFIN_VENDOR_PAT=

# --- ClickHouse (기본값으로 로컬에 붙습니다) ---
# CLUEFIN_CLICKHOUSE_HOST=localhost
# CLUEFIN_CLICKHOUSE_PORT=8123
# CLUEFIN_CLICKHOUSE_USER=default
# CLUEFIN_CLICKHOUSE_PASSWORD=
# CLUEFIN_CLICKHOUSE_SECURE=0

# --- 데이터 원천 ---
DART_AUTH_KEY=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
BOK_ECOS_API_KEY=

# --- 증권사 API (브로커 클라이언트를 쓸 때만) ---
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_ENV=dev
KIS_APP_KEY=
KIS_SECRET_KEY=
KIS_ENV=dev
